name: basic-mlflow-example

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      alpha:
        type: float
        default: 0.5
      l1_ratio:
        type: float
        default: 0.5
    command: "python basics_example.py {alpha} {l1_ratio}"

  logging:
    command: "python logging.py"